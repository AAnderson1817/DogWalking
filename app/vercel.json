{
  "rewrites": [
    {
      "source": "/((?!assets/|icons/|fonts/|sw\\.js|manifest\\.webmanifest|version\\.json).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/version.json",
      "headers": [{ "key": "Cache-Control", "value": "no-store, max-age=0" }]
    }
  ]
}
